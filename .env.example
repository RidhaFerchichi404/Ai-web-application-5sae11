APP_ENV=development

# Supabase — use the Transaction Pooler connection string (port 6543) for deployed environments.
# For local PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/local_ai_assistant
DATABASE_URL=postgresql+psycopg2://postgres:[password]@db.[ref].supabase.co:6543/postgres

# Ollama — for local dev use http://localhost:11434
# For deployed environments expose Ollama via ngrok and set the public URL here.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

MAX_FILE_SIZE_MB=25

UPLOAD_DIRECTORY=./storage/uploads

# Comma-separated list of allowed origins for CORS.
# Example for production: https://your-app.vercel.app,https://your-app.vercel.app
CORS_ORIGINS=["http://localhost:3000"]
